# Your own keys. Copy this file to .env and paste each key after its = sign: no quotes, no spaces around the =.
# .env is git-ignored, so it stays on your computer. Never paste a key into a chat or a commit.

# ElevenLabs (voices and sound effects): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Google Gemini (hears the finished mix; optional images): https://aistudio.google.com/apikey
GEMINI_API_KEY=
